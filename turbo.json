{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/docs/**"],
      "env": ["API_URL", "NEXT_PUBLIC_*", "EXPO_PUBLIC_*"],
      "passThroughEnv": ["GIT_SHA"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/docs/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/docs/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/docs/**"],
      "env": ["DATABASE_URL", "JWT_SECRET", "NODE_ENV"],
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
