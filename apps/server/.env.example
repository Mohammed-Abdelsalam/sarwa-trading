PORT=4000
DATABASE_URL="file:./dev.db"
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:8081"
# Use a long random value outside local dev; production refuses this example value.
JWT_SECRET="dev-only-change-me-to-a-long-random-string"
# Proxies allowed to set X-Forwarded-For: "loopback" (the web and admin Next rewrites), a hop count or a list.
TRUST_PROXY="loopback"
# Emailed links (verify, password reset, admin invites) point here.
WEB_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3001"
ADMIN_EMAIL="admin@sarwa.dev"
ADMIN_PASSWORD="admin12345"
VIEWER_EMAIL="viewer@sarwa.dev"
VIEWER_PASSWORD="viewer12345"
