PORT=4000
# SQLite file, relative to prisma/schema.prisma
DATABASE_URL="file:./dev.db"
# Comma-separated origins allowed by CORS (web, admin, Expo web)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:8081"
# Signs the admin session cookie. Use a long random value outside local dev.
JWT_SECRET="dev-only-change-me-to-a-long-random-string"
# Seeded demo accounts (only used the first time the database is created)
ADMIN_EMAIL="admin@sarwa.dev"
ADMIN_PASSWORD="admin12345"
VIEWER_EMAIL="viewer@sarwa.dev"
VIEWER_PASSWORD="viewer12345"
