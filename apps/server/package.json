{
  "name": "@sarwa/server",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS API: REST + Socket.IO price stream + market simulator + admin API (Prisma/SQLite).",
  "scripts": {
    "dev": "pnpm db:setup && nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "db:setup": "node scripts/ensure-env.mjs && prisma migrate deploy && prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/ensure-env.mjs && jest --runInBand",
    "postinstall": "prisma generate",
    "clean": "rimraf dist coverage .turbo"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.12",
    "@sarwa/eslint-config": "workspace:*",
    "@sarwa/jest-config": "workspace:*",
    "@sarwa/tsconfig": "workspace:*",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.7",
    "@types/supertest": "^7.2.1",
    "prisma": "^6.19.3",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.12",
    "@nestjs/core": "^11.2.12",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.12",
    "@nestjs/platform-socket.io": "^11.2.12",
    "@nestjs/throttler": "^6.8.0",
    "@nestjs/websockets": "^11.2.12",
    "@prisma/client": "^6",
    "@sarwa/contracts": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  }
}
