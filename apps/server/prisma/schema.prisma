// SQLite for zero-setup local runs; switch provider and DATABASE_URL to use Postgres.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Stock {
  symbol         String   @id
  name           String
  sector         String
  exchange       String
  basePrice      Float
  volatility     Float    @default(1)
  marketCap      Float    @default(0)
  peRatio        Float?
  isEnabled      Boolean  @default(true)
  // Live price persisted so a restart doesn't re-randomize resting stop/limit triggers.
  lastTicks      BigInt?
  // The trading day's reference prices, so a restart keeps today's change and range.
  tradingDate    String?
  prevCloseTicks BigInt?
  openTicks      BigInt?
  dayHighTicks   BigInt?
  dayLowTicks    BigInt?
  updatedAt      DateTime @updatedAt

  watchers  WatchlistItem[]
  positions Position[]
  orders    Order[]
  fills     Fill[]
  alerts    Alert[]
}

// A browser or phone; until it signs in, its paper account (if any) is the guest's.
model Device {
  id         String   @id
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  account Account?

  @@index([lastSeenAt])
}

model WatchlistItem {
  accountId String
  symbol    String
  createdAt DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  stock   Stock   @relation(fields: [symbol], references: [symbol], onDelete: Cascade)

  @@id([accountId, symbol])
  @@index([symbol])
}

// A customer. Purging a deleted account anonymizes the row; its trading history stays.
model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String
  passwordHash        String
  status              String    @default("active")
  emailVerifiedAt     DateTime?
  passwordChangedAt   DateTime?
  failedLogins        Int       @default(0)
  lockedUntil         DateTime?
  deletionRequestedAt DateTime?
  signupPlatform      String    @default("web")
  suspensionCategory  String?
  suspensionReason    String?
  suspendedAt         DateTime?
  suspendedBy         String?
  createdAt           DateTime
  lastActiveAt        DateTime?

  account      Account?
  sessions     Session[]
  resetTokens  PasswordResetToken[]
  verifyTokens EmailVerificationToken[]

  @@index([status])
  @@index([createdAt])
  @@index([lastActiveAt])
  @@index([deletionRequestedAt])
}

// One row per refresh token. Rows of one sign-in share a familyId, which is the session's public
// id; rotating marks the old row so presenting it again revokes the whole family.
model Session {
  id           String    @id @default(cuid())
  familyId     String
  userId       String
  refreshHash  String    @unique
  keepSignedIn Boolean
  platform     String
  label        String
  browser      String?
  os           String?
  model        String?
  ip           String?
  ipMasked     String
  createdAt    DateTime
  lastUsedAt   DateTime
  expiresAt    DateTime
  rotatedAt    DateTime?
  revokedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  createdAt DateTime
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  createdAt DateTime
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AdminInvite {
  id         String    @id @default(cuid())
  email      String
  role       String
  tokenHash  String    @unique
  invitedBy  String
  createdAt  DateTime
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?

  @@index([email])
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         String    @default("VIEWER")
  status       String    @default("active")
  lastActiveAt DateTime?
  createdAt    DateTime  @default(now())
  // Bumped on sign-out: every token issued before it stops working.
  tokenVersion Int       @default(0)
  // Consecutive wrong passwords; reaching the limit locks sign-in until lockedUntil.
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
}

model AppConfig {
  id              Int      @id @default(1)
  maintenanceMode Boolean  @default(false)
  bannerMessage   String?
  bannerTone      String   @default("info")
  enabledPeriods  String   @default("1D,1W,1M,1Y,ALL")
  updatedAt       DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorEmail String
  action     String
  entity     String
  payload    String
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([entity, createdAt])
}

// Money, quantities and prices are integers in their smallest unit (cents, micros, ticks).
// Owned by a user, or by a device while its visitor is a guest.
model Account {
  id        String    @id @default(cuid())
  deviceId  String?   @unique
  userId    String?   @unique
  handle    String    @unique
  cashCents BigInt
  // Bumped by a reset: history is kept and the books start again in the new epoch.
  epoch     Int       @default(0)
  createdAt DateTime
  resetAt   DateTime?

  device        Device?             @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  user          User?               @relation(fields: [userId], references: [id])
  positions     Position[]
  orders        Order[]
  fills         Fill[]
  alerts        Alert[]
  notifications Notification[]
  snapshots     PortfolioSnapshot[]
  watchlist     WatchlistItem[]
  pushTokens    PushToken[]
}

model Position {
  accountId      String
  symbol         String
  qtyMicros      BigInt
  costBasisCents BigInt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  stock   Stock   @relation(fields: [symbol], references: [symbol], onDelete: Restrict)

  @@id([accountId, symbol])
  @@index([symbol])
}

model Order {
  id                  String    @id @default(cuid())
  accountId           String
  epoch               Int
  symbol              String
  side                String
  type                String
  tif                 String
  status              String
  qtyMicros           BigInt?
  amountCents         BigInt?
  sellAll             Boolean   @default(false)
  limitTicks          BigInt?
  stopTicks           BigInt?
  quotedTicks         BigInt
  filledMicros        BigInt    @default(0)
  filledNotionalCents BigInt    @default(0)
  filledExactNotional String    @default("0")
  heldCents           BigInt    @default(0)
  heldMicros          BigInt    @default(0)
  holdPriceTicks      BigInt?
  holdBudgetCents     BigInt?
  rejection           String?
  cancelReason        String?
  idempotencyKey      String
  requestHash         String
  latencyMs           Int       @default(0)
  createdAt           DateTime
  updatedAt           DateTime
  triggeredAt         DateTime?
  expiresAt           DateTime?
  closedAt            DateTime?

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  stock   Stock   @relation(fields: [symbol], references: [symbol], onDelete: Restrict)
  fills   Fill[]

  @@unique([accountId, idempotencyKey])
  @@index([status])
  @@index([symbol, status])
  @@index([accountId, createdAt])
  // Housekeeping looks up expired working orders every second; admin stats scan today's orders.
  @@index([status, expiresAt])
  @@index([createdAt])
}

model Fill {
  id            String   @id @default(cuid())
  orderId       String
  accountId     String
  epoch         Int
  symbol        String
  side          String
  qtyMicros     BigInt
  priceTicks    BigInt
  notionalCents BigInt
  realizedCents BigInt
  at            DateTime

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  stock   Stock   @relation(fields: [symbol], references: [symbol], onDelete: Restrict)

  @@index([orderId])
  @@index([accountId, at])
  @@index([at])
}

model Alert {
  id             String    @id @default(cuid())
  accountId      String
  symbol         String
  condition      String
  thresholdTicks BigInt?
  thresholdBps   Int?
  repeat         String
  enabled        Boolean   @default(true)
  armed          Boolean   @default(true)
  lastFiredAt    DateTime?
  createdAt      DateTime

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  stock   Stock   @relation(fields: [symbol], references: [symbol], onDelete: Cascade)

  @@index([accountId])
  @@index([enabled])
}

model Notification {
  id        String    @id @default(cuid())
  accountId String
  payload   String
  readAt    DateTime?
  createdAt DateTime

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
}

model PortfolioSnapshot {
  id          Int      @id @default(autoincrement())
  accountId   String
  epoch       Int
  t           DateTime
  equityCents BigInt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, epoch, t])
}

model PushToken {
  token     String   @id
  accountId String
  platform  String
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model Halt {
  id        String    @id @default(cuid())
  symbol    String
  source    String
  message   String
  since     DateTime
  resumesAt DateTime?
  endedAt   DateTime?
  createdBy String?

  @@index([symbol, endedAt])
}

model TradingConfig {
  id             Int      @id @default(1)
  tradingEnabled Boolean  @default(true)
  sessionMode    String   @default("always-open")
  rules          String
  circuitBreaker String
  changedBy      String?
  updatedAt      DateTime @updatedAt
}
