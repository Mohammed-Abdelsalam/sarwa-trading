{
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "arrowParens": "always",
  "endOfLine": "lf",
  "plugins": ["prettier-plugin-tailwindcss"],
  "tailwindFunctions": ["cn", "cva"],
  "overrides": [
    {
      "files": "apps/mobile/**",
      "options": {
        "tailwindConfig": "./apps/mobile/tailwind.config.js"
      }
    }
  ]
}
